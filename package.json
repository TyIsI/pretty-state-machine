{
    "name": "pretty-state-machine",
    "version": "0.0.10",
    "description": "A pretty simple state store for React/Javascript",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "watch": "pnpm build -- --watch src",
        "format": "prettier -w src/** tests/**",
        "lint": "eslint --fix src/** tests/**",
        "test": "jest",
        "commit": "npx git-cz@latest",
        "release": "npx standard-version",
        "postbuild": "git add dist && git commit -m \"chore: dist build\" || true",
        "prebuild": "pnpm test",
        "prepublishOnly": "pnpm build",
        "prerelease": "pnpm build",
        "postrelease": "git push --follow-tags origin trunk && npm publish",
        "pretest": "pnpm lint",
        "postlint": "pnpm format",
        "preinstall": "npx only-allow pnpm"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tyisi/pretty-state-machine.git"
    },
    "keywords": [
        "store",
        "state"
    ],
    "author": "TyIsI",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/tyisi/pretty-state-machine/issues"
    },
    "homepage": "https://github.com/tyisi/pretty-state-machine#readme",
    "dependencies": {
        "copy-anything": "^3.0.2",
        "debug": "^4.3.2",
        "eventemitter3": "^4.0.7"
    },
    "devDependencies": {
        "@babel/core": "7.22.11",
        "@babel/preset-env": "7.22.10",
        "@babel/preset-typescript": "7.22.11",
        "@testing-library/jest-dom": "6.1.2",
        "@types/debug": "4.1.8",
        "@types/jest": "29.5.4",
        "@types/node": "18.17.1",
        "@typescript-eslint/eslint-plugin": "^7.0.1",
        "@typescript-eslint/parser": "6.4.1",
        "babel-jest": "29.6.4",
        "cz-conventional-changelog": "3.3.0",
        "eslint": "^8.0.1",
        "eslint-config-love": "^47.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.25.2",
        "eslint-plugin-jest": "^28.2.0",
        "eslint-plugin-n": "^15.0.0",
        "eslint-plugin-promise": "^6.0.0",
        "jest": "29.6.4",
        "jest-environment-jsdom": "29.6.4",
        "jest-localstorage-mock": "2.4.26",
        "prettier": "3.0.2",
        "ts-node": "10.9.1",
        "tsup": "7.2.0",
        "typescript": "5.1.6"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
